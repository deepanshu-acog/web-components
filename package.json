{
  "name": "@aganitha/atk-ui",
  "version": "0.0.0",
  "description": "Aganitha's shared UI layer: brand theme, our components, and agent skills.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json",
    "skills"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./theme.css": "./dist/theme/theme.css",
    "./patterns.css": "./dist/patterns/patterns.css",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@awesome.me/webawesome": "^3.11.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.11.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@happy-dom/global-registrator": "20.11.1",
    "@types/bun": "latest",
    "happy-dom": "20.11.1",
    "lit": "^3.3.3",
    "typescript": "^5.9.3"
  }
}
